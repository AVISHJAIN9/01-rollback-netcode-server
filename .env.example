# Example environment configuration for Rollback Netcode Server
# Copy this file to .env and customize for your environment
# Do NOT commit .env to git (it should be in .gitignore)

# Server timing and behavior
ROLLBACK_TICK_RATE=60
ROLLBACK_RECONNECT_TIMEOUT_SECS=30
ROLLBACK_STALE_SESSION_THRESHOLD_SECS=40

# Network ports
ROLLBACK_UDP_GAME_PORT=7777
ROLLBACK_HTTP_ADMIN_PORT=8080
ROLLBACK_FRONTEND_PORT=3000

# Database URLs (REQUIRED)
ROLLBACK_POSTGRES_URL=postgres://postgres:postgrespassword@localhost:5432/rollback_db
ROLLBACK_REDIS_URL=redis://localhost:6379/0

# Feature flags (all default to off for safety)
ROLLBACK_ENABLE_AI_CHEAT_DETECTION=0
ROLLBACK_ENABLE_JITTER_PREDICTION=0
ROLLBACK_ENABLE_ROLLBACK_RISK_METRICS=0
ROLLBACK_ENABLE_MATCHMAKING_OPTIMIZER=0

# Logging
RUST_LOG=rollback_netcode_server=info,warn
